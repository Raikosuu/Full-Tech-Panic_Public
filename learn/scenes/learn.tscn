[sub_resource type="GDScript" id="GDScript_ma7se"]
script/source = "extends Button

@onready var learnpanel: Panel = $\"../learnpanel\"
@onready var mobopanel: Panel = $\"../mobopanel\"

func _ready():
	learnpanel.visible = true
	mobopanel.visible = false

func _on_pressed() -> void:
	learnpanel.visible = true
	mobopanel.visible = true


func _on_mobo_pressed() -> void:
	_ready()
"

