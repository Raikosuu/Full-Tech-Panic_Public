[sub_resource type="GDScript" id="GDScript_nneaa"]
script/source = "extends Button

@onready var learnpanel: Panel = $\"../learnpanel\"
@onready var cpupanel: Panel = $\"../cpupanel\"

func _ready():
	learnpanel.visible = true
	cpupanel.visible = false
	
func _on_pressed() -> void:
	learnpanel.visible = true
	cpupanel.visible = true


func _on_cpu_pressed() -> void:
	_ready()
"

