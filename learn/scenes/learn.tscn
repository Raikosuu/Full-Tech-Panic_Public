[node name="desc" type="Label" parent="cpupanel/VBoxContainer/ScrollContainer" unique_id=651147957]
custom_minimum_size = Vector2(211, 234)
layout_mode = 2
size_flags_vertical = 3
theme_override_fonts/font = ExtResource("8_ma7se")
theme_override_font_sizes/font_size = 12
text = "The CPU is a critical hardware component responsible for processing instructions from software and coordinating the activities of all other computer components . It interprets binary signals (1s and 0s) to perform calculations, make decisions, and control data flow, enabling tasks like gaming, video playback, and running applications."
autowrap_mode = 2

