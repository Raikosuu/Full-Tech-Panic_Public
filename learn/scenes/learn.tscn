text = "Motherboard"

[node name="ScrollContainer" type="ScrollContainer" parent="mobopanel/VBoxContainer" unique_id=1322788141]
custom_minimum_size = Vector2(211, 234)
layout_mode = 2

[node name="desc" type="Label" parent="mobopanel/VBoxContainer/ScrollContainer" unique_id=1860606785]
custom_minimum_size = Vector2(211, 234)
layout_mode = 2
size_flags_vertical = 3
theme_override_fonts/font = ExtResource("8_ma7se")
theme_override_font_sizes/font_size = 12
text = "A motherboard is the main circuit board of a computer that connects and allows communication between all essential components, acting as the backbone of the system.

A motherboard, also called a mainboard, system board, or logic board, is the largest printed circuit board (PCB) inside a computer. It distributes power and facilitates communication between the CPU (Central Processing Unit), RAM (Random Access Memory), storage devices, and peripheral components. Essentially, it serves as the central hub that allows all parts of a computer to work together efficiently, making it the backbone or “spine” of the system."
autowrap_mode = 2

