[node name="ScrollContainer" type="ScrollContainer" parent="rampanel/VBoxContainer" unique_id=513949647]
custom_minimum_size = Vector2(211, 234)
layout_mode = 2

[node name="desc" type="Label" parent="rampanel/VBoxContainer/ScrollContainer" unique_id=694061216]
custom_minimum_size = Vector2(211, 234)
layout_mode = 2
size_flags_vertical = 3
theme_override_fonts/font = ExtResource("8_ma7se")
theme_override_font_sizes/font_size = 12
text = "RAM (Random Access Memory) is your computer’s short-term memory, temporarily storing data for fast access by the CPU to ensure smooth performance.

RAM is a type of volatile memory that temporarily holds data and instructions that your computer’s CPU needs while running programs, apps, or the operating system . Unlike permanent storage like hard drives or SSDs, data in RAM is lost when the computer is powered off . Think of it as the brain’s short-term memory: it keeps information readily available for immediate use, allowing your system to multitask efficiently."
autowrap_mode = 2

