[node name="ScrollContainer" type="ScrollContainer" parent="hddpanel/VBoxContainer" unique_id=462507317]
custom_minimum_size = Vector2(211, 234)
layout_mode = 2

[node name="desc" type="Label" parent="hddpanel/VBoxContainer/ScrollContainer" unique_id=1716766411]
custom_minimum_size = Vector2(211, 234)
layout_mode = 2
size_flags_vertical = 3
theme_override_fonts/font = ExtResource("8_ma7se")
theme_override_font_sizes/font_size = 12
text = "A hard disk drive (HDD) is a non-volatile storage device that uses spinning magnetic platters and read/write heads to store and retrieve digital data. 

An HDD, also called a hard drive or fixed disk, is a traditional mechanical storage device used in computers to store operating systems, applications, and user data. Unlike volatile memory (RAM), HDDs retain data even when the computer is powered off, making them ideal for long-term storage and large media libraries. HDDs are commonly found inside desktops, laptops, and external enclosures, and they are measured in gigabytes (GB) or terabytes (TB) of capacity."
autowrap_mode = 2

