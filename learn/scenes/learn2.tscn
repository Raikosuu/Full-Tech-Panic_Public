[node name="ScrollContainer" type="ScrollContainer" parent="psupanel/VBoxContainer" unique_id=2089062261]
custom_minimum_size = Vector2(211, 234)
layout_mode = 2

[node name="desc" type="Label" parent="psupanel/VBoxContainer/ScrollContainer" unique_id=171740471]
custom_minimum_size = Vector2(211, 234)
layout_mode = 2
size_flags_vertical = 3
theme_override_fonts/font = ExtResource("11_h4knm")
theme_override_font_sizes/font_size = 12
text = "A Power Supply Unit (PSU) is a crucial component of a computer system that converts external electrical power into the specific voltage and current required by various components within the computer. It supplies power to all other components, ensuring stable and reliable operation. The PSU typically converts alternating current (AC) from the wall outlet into direct current (DC) used by the computer's internal parts."
autowrap_mode = 2

