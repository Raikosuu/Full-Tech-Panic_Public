[node name="desc" type="Label" parent="computertowerpanel/VBoxContainer/ScrollContainer" unique_id=702166531]
custom_minimum_size = Vector2(211, 234)
layout_mode = 2
size_flags_vertical = 3
theme_override_fonts/font = ExtResource("11_h4knm")
theme_override_font_sizes/font_size = 12
text = "A computer tower, also known as a PC case, chassis, or system unit, is the enclosure that contains the core components of a desktop computer, including the motherboard, CPU, GPU, RAM, storage drives, and power supply. Its vertical design allows for better airflow, easier access to components, and more space for expansion compared to horizontal \"pizza box\" cases. Towers are typically placed on the floor next to a desk, though they can also sit on top of a desk."
autowrap_mode = 2

