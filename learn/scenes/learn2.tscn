text = "Cooling Fan "

[node name="ScrollContainer" type="ScrollContainer" parent="coolingfanpanel/VBoxContainer" unique_id=1288521379]
custom_minimum_size = Vector2(211, 234)
layout_mode = 2

[node name="desc" type="Label" parent="coolingfanpanel/VBoxContainer/ScrollContainer" unique_id=263861649]
custom_minimum_size = Vector2(211, 234)
layout_mode = 2
size_flags_vertical = 3
theme_override_fonts/font = ExtResource("11_h4knm")
theme_override_font_sizes/font_size = 12
text = "A cooling fan is designed to remove excess heat from devices or machinery to ensure stable operation and prevent damage caused by overheating. It achieves this by using a motor to rotate fan blades, which generate airflow that carries heat away from the surface of the component or system, lowering its temperature and maintaining efficiency and reliability in operation.

Cooling fans operate on the principle of convective heat transfer. The motor drives the fan blades to rotate at high speed, creating airflow. This airflow passes over hot surfaces, such as heat sinks, radiators, or electronic components, absorbing heat and expelling it into the surrounding environment. This continuous exchange of cooler and warmer air enhances the cooling effect."
autowrap_mode = 2

