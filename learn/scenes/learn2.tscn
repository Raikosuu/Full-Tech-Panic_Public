[node name="desc" type="Label" parent="gpupanel/VBoxContainer/ScrollContainer" unique_id=1841588749]
custom_minimum_size = Vector2(211, 234)
layout_mode = 2
size_flags_vertical = 3
theme_override_fonts/font = ExtResource("11_h4knm")
theme_override_font_sizes/font_size = 12
text = "A graphics card is a computer component that renders images, videos, and 3D graphics, with a GPU as its core processor, enabling high-performance visual computing for gaming, video editing, and AI tasks.

A graphics card, also called a video card or GPU, is an expansion card that generates graphics output for a display device such as a monitor . It can be integrated into the motherboard or CPU, or discrete, meaning it is a separate component installed in an expansion slot for higher performance. Discrete graphics cards are essential for tasks that require intensive graphics processing, such as gaming, 3D rendering, and video editing."
autowrap_mode = 2

