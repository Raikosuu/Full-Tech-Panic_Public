theme_override_fonts/font = ExtResource("7_5iac7")
theme_override_font_sizes/font_size = 12
text = "A sound card, also known as an audio card or soundboard, is either an internal expansion card or an integrated component on a computer's motherboard that allows the computer to produce and record sound through speakers, headphones, or microphones. It functions as a translator between digital audio data and analog sound waves, using a digital-to-analog converter (DAC) to output sound and an analog-to-digital converter (ADC) to record audio."
